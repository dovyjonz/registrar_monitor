<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'">
    <title>{% block title %}{{ page_title or "Enrollment Monitor" }}{% endblock %}</title>
    <meta name="description" content="{% block description %}{{ page_description }}{% endblock %}">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='8' fill='%23ff9100'%2F%3E%3C%2Fsvg%3E">
    <meta name="theme-color" content="#ffd700">

    <meta name="robots" content="noindex, nofollow">

    {# Open Graph tags for social sharing #}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Enrollment Monitor">
    <meta property="og:title" content="{% block og_title %}{{ page_title or "Enrollment Monitor" }}{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ page_description }}{% endblock %}">
    {% if og_url %}<meta property="og:url" content="{{ og_url }}">{% endif %}
    {% if image_url %}<meta property="og:image" content="{{ image_url }}">{% endif %}
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{ image_alt }}">

    {# Twitter Card tags #}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title or "Enrollment Monitor" }}">
    <meta name="twitter:description" content="{{ page_description }}">
    {% if image_url %}<meta name="twitter:image" content="{{ image_url }}">{% endif %}

    {# Canonical URL #}
    {% block canonical %}{% if canonical_url %}<link rel="canonical" href="{{ canonical_url }}">{% endif %}{% endblock %}

    {# Inject CSS from Vite build #}
    {% if css_file %}
    <link rel="stylesheet" href="{{ asset_base_url }}{{ css_file }}">
    {% endif %}
    {% if js_file %}
    <link rel="modulepreload" href="{{ asset_base_url }}{{ js_file }}">
    {% endif %}

    {% block head %}{% endblock %}
</head>
<body{% block body_attrs %}{% endblock %}>
    {% block content %}{% endblock %}

    {# Inject JS from Vite build #}
    {% if js_file %}
    <script type="module" src="{{ asset_base_url }}{{ js_file }}"></script>
    {% endif %}
</body>
</html>
