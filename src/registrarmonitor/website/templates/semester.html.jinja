{% extends "base.html.jinja" %}

{% block title %}{{ title }}{% endblock %}
{% block description %}{{ title }} enrollment dashboard — track course fill percentages, section availability, and registration trends at Nazarbayev University.{% endblock %}
{% block og_title %}{{ title }}{% endblock %}
{% block og_description %}Real-time enrollment tracking for {{ title }} at Nazarbayev University. View course availability, capacity changes, and registration trends.{% endblock %}
{% block twitter_title %}{{ title }}{% endblock %}
{% block twitter_description %}Real-time enrollment tracking for {{ title }} at Nazarbayev University.{% endblock %}

{% block body_attrs %} data-manifest-url="{{ manifest_filename }}"{% endblock %}

{% block content %}
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header>
        <div class="header-topline">
            <h1>Enrollment Monitor</h1>
            <nav class="semester-links" aria-label="Semester navigation">
                {{ nav_html | safe }}
            </nav>
        </div>
        <div class="header-summary">
            <p id="lastUpdated">{{ last_updated }}</p>
            <section class="stats" aria-label="Statistics">
                <div class="stat">
                    <div class="stat-value" id="totalCourses">0</div>
                    <div class="stat-label">Courses</div>
                </div>
                <div class="stat">
                    <div class="stat-value" id="totalSections">0</div>
                    <div class="stat-label">Sections</div>
                </div>
                <div class="stat">
                    <div class="stat-value" id="fullSections">0</div>
                    <div class="stat-label">Full</div>
                </div>
                <div class="stat" title="Number of data snapshots collected over time">
                    <div class="stat-value" id="snapshotCount">0</div>
                    <div class="stat-label">Snapshots</div>
                </div>
            </section>
        </div>
        <details class="milestone-details">
            <summary>
                <span>Registration timeline</span>
                <span class="milestone-summary-value" id="milestoneSummaryValue">View milestones</span>
            </summary>
            <div class="milestone-progress" id="milestoneProgress" aria-label="Registration progress"></div>
        </details>
    </header>

    <!-- Unified Controls Panel -->
    <div class="controls-panel">
        <div class="controls-row">
            <div class="search-field">
                <label for="courseSearch" class="visually-hidden">Search courses</label>
                <input type="search" id="courseSearch" placeholder="Search courses..."
                    class="search-input">
                <button type="button" class="search-clear" id="clearSearch" aria-label="Clear search" title="Clear search" hidden>×</button>
                <span class="search-hint" aria-hidden="true"><kbd>/</kbd></span>
            </div>
            <span id="searchAnnouncement" aria-live="polite" class="visually-hidden"></span>

            <div class="filter-buttons" role="group" aria-label="Filter by status">
                <button type="button" class="filter-btn active" data-filter="all" title="Show all courses" aria-pressed="true">All</button>
                <button type="button" class="filter-btn" data-filter="full" title="Show full courses only" aria-pressed="false">Full</button>
                <button type="button" class="filter-btn" data-filter="near" title="Show near-full courses" aria-pressed="false">Near</button>
                <button type="button" class="filter-btn" data-filter="open" title="Show open courses" aria-pressed="false">Open</button>
                <button type="button" class="filter-btn" data-filter="starred" title="Show bookmarked courses" aria-label="Show bookmarked courses" aria-pressed="false">
                    <svg class="filter-bookmark-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M7.25 4.75A2.25 2.25 0 0 1 9.5 2.5h5A2.25 2.25 0 0 1 16.75 4.75V21L12 17.8 7.25 21V4.75Z"></path>
                    </svg>
                    <span>Starred</span>
                </button>
            </div>

            <label for="sortSelect" class="visually-hidden">Sort courses</label>
            <select id="sortSelect" class="sort-select" title="Sort courses by">
                <option value="department">By Department</option>
                <option value="code">By Code</option>
                <option value="fill-desc">Fill % (High→Low)</option>
                <option value="fill-asc">Fill % (Low→High)</option>
            </select>
            <button type="button" class="department-toggle" id="departmentToggle"
                aria-controls="departmentPanel" aria-expanded="false" hidden>
                Departments <span id="departmentCount"></span>
                <span class="department-toggle-icon" aria-hidden="true">⌄</span>
            </button>
        </div>

        <div class="department-panel" id="departmentPanel" hidden>
            <label for="departmentSearch" class="visually-hidden">Find department</label>
            <input type="search" id="departmentSearch" class="department-search"
                placeholder="Find department…" autocomplete="off" spellcheck="false">
            <nav class="jump-to-nav" id="jumpToNav" aria-label="Jump to department"></nav>
            <p class="department-empty" id="departmentEmpty" hidden>No matching department</p>
        </div>
    </div>

    <main id="main-content">
        <div class="course-grid" id="courseGrid">
            <div id="loadingIndicator" class="loading-indicator">
                <div class="loading-spinner" aria-hidden="true"></div>
                <p class="loading-message">Loading enrollment data...</p>
            </div>
        </div>
    </main>

    <!-- Toast notification container -->
    <div id="toastContainer" class="toast-container" role="status" aria-live="polite" aria-atomic="true"></div>

    <div class="modal-overlay" id="modalOverlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="modal">
            <div class="modal-header">
                <div class="modal-header-left">
                    <h2 id="modalTitle" class="modal-course-heading" aria-label="Course details">
                        <span class="modal-course-code" id="modalCourseCode">Course</span>
                        <span class="modal-course-name" id="modalCourseName">Details</span>
                    </h2>
                </div>
                <div class="modal-header-right">
                    <button type="button" class="modal-icon-btn bookmark-btn" id="modalBookmark"
                        aria-label="Bookmark course" aria-pressed="false" title="Bookmark this course">
                        <svg class="modal-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path class="modal-icon-bookmark" d="M7.25 4.75A2.25 2.25 0 0 1 9.5 2.5h5A2.25 2.25 0 0 1 16.75 4.75V21L12 17.8 7.25 21V4.75Z"></path>
                        </svg>
                    </button>
                    <button type="button" class="modal-icon-btn share-btn" id="modalShareLink"
                        aria-label="Copy share link" title="Copy share link" style="display:none;">
                        <svg class="modal-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <circle cx="6.75" cy="12" r="2.25"></circle>
                            <circle cx="17.25" cy="6.5" r="2.25"></circle>
                            <circle cx="17.25" cy="17.5" r="2.25"></circle>
                            <path d="m8.8 10.9 6.4-3.35M8.8 13.1l6.4 3.35"></path>
                        </svg>
                    </button>
                    <button type="button" class="modal-icon-btn close-btn" id="modalCloseBtn" aria-label="Close modal">
                        <svg class="modal-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M5 5 19 19"></path>
                            <path d="m19 5-14 14"></path>
                        </svg>
                    </button>
                </div>
            </div>
            <div class="modal-body">
                <div class="section-type-selector" id="sectionTypeSelector"></div>
                <div class="section-list" id="sectionList" role="list"></div>

                <div class="chart-container" id="chartContainer">
                    <div class="chart-toolbar">
                        <!-- Chart mode toggle -->
                        <div class="chart-mode-toggle" id="chartModeToggle" role="group" aria-label="Chart display mode">
                            <button class="chart-mode-btn active" data-mode="phased" aria-pressed="true" title="Equal-width registration phases">Phases</button>
                            <button class="chart-mode-btn" data-mode="snapshots" aria-pressed="false" title="Equal-width snapshots">Steps</button>
                            <button class="chart-mode-btn" data-mode="timeline" aria-pressed="false" title="Elapsed time with long gaps shortened">Time</button>
                        </div>
                        <div class="chart-action-controls">
                            <div class="chart-zoom-controls">
                                <button type="button" class="chart-zoom-btn" id="chartZoomReset" disabled title="Reset chart zoom">Reset zoom</button>
                            </div>
                            <div class="historical-comparison-controls" id="historicalComparisonControls" hidden data-state="hidden">
                                <button type="button" class="historical-comparison-toggle" id="historicalComparisonToggle"
                                    aria-pressed="false" aria-label="Show an earlier semester comparison" disabled>
                                    Earlier semester
                                </button>
                            </div>
                            <div class="chart-legend" id="chartLegend">
                                <div class="chart-legend-item">
                                    <span class="capacity-legend-line" aria-hidden="true"></span>
                                    <span>Capacity</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="chart-wrapper">
                        <div class="chart-placeholder" id="chartPlaceholder">
                            Click a section to view enrollment history
                        </div>
                        <canvas id="enrollment-chart" class="chart-hidden" aria-label="Enrollment chart" aria-describedby="chartSummary" role="img"></canvas>
                        <div class="chart-readout" id="chartReadout" aria-live="polite" hidden></div>
                        <p id="chartSummary" class="visually-hidden">Select a course to view its enrollment history.</p>
                    </div>
                </div>

                <!-- Collapsible event history -->
                <details class="event-history" id="eventHistory">
                    <summary class="event-history-summary">
                        <span class="event-history-icon">&gt;</span>
                        Course Event History
                        <span class="event-count" id="eventCount"></span>
                    </summary>
                    <div class="event-filters" id="eventFilters"></div>
                    <div class="event-history-list" id="eventHistoryList"></div>
                </details>
            </div>
        </div>
    </div>
{% endblock %}
