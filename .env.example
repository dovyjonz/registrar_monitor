TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Show the private /test diagnostics command to one operator.
# TELEGRAM_BOT_TEST_USER_ID=

# Optional Cloudflare/Wrangler deployment credentials.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Optional external heartbeat (Healthchecks.io-compatible), pinged after each
# successful poll. Configure the "quiet" alert and its Telegram integration on
# the Healthchecks.io side.
# HEARTBEAT_URL=

# Optional Sentry error reporting; disabled when SENTRY_DSN is unset.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# Set to "json" to force JSON logs for interactive CLI commands. The schedule
# and bot services always log JSON.
# LOG_FORMAT=

# Litestream replication to Cloudflare R2 (registrarmonitor-litestream unit).
# R2_ACCOUNT_ID=
# R2_BUCKET=
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# scripts/deploy_vm.sh target (see the script header for defaults).
# VM_HOST=
# VM_USER=
# VM_PATH=
