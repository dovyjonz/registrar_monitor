{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "registrar-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [{ "pattern": "seatwatch.fyi", "custom_domain": true }],
  // The generated dashboard (frontend/public): HTML routes, /data JSON, hashed assets.
  // Static Assets requests are free and unlimited and do not invoke the Worker;
  // only the path below runs code. The Telegram Mini App API lives on the bot.
  "assets": {
    "directory": "../../frontend/public",
    "binding": "ASSETS",
    "run_worker_first": ["/preview/*"]
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
