{
    "name": "registrar-monitor-website",
    "private": true,
    "description": "Cloudflare Pages frontend for Registrar Monitor",
    "engines": {
        "node": ">=24.18.0 <25",
        "npm": ">=11 <12"
    },
    "scripts": {
        "dev": "vite",
        "test": "npm run test:unit",
        "test:unit": "node --test test/*.test.mjs",
        "test:e2e": "playwright test",
        "test:e2e:stability": "playwright test --grep 'chart drag|professor no-history|continuous phased time|pinned readout|touch dragging|pinch zoom'",
        "test:e2e:webkit": "PLAYWRIGHT_BROWSER=webkit playwright test --grep @webkit",
        "lint": "eslint .",
        "build": "vite build"
    },
    "dependencies": {
        "chart.js": "^4.4.1",
        "chartjs-plugin-annotation": "^3.0.1",
        "chartjs-plugin-zoom": "^2.2.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.62.1",
        "eslint": "10.9.1",
        "globals": "17.11.0",
        "vite": "8.2.2",
        "wrangler": "4.127.0"
    }
}
